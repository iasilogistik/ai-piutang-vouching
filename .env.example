DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_piutang_vouching
APP_ENV=development
# Production persistent evidence storage. Use a server-only Supabase secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=audit-documents

# Enable only after Supabase Auth and production roles are configured.
AUTH_REQUIRED=false

# Public URL used for email flows such as password reset.
APP_BASE_URL=https://ai-piutang-vouching.vercel.app
PASSWORD_RESET_REDIRECT_URL=https://ai-piutang-vouching.vercel.app/reset-password
